# ─────────────────────────────────────────────────────────────
# Atlas AI (Wayfare) — Backend environment
# Copy this file to `.env` and fill in the two secrets marked REQUIRED.
# The server validates these on boot and fails fast if a required var is missing.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=5000

# Database — local MongoDB by default. For Atlas, paste your SRV connection string.
MONGODB_URI=mongodb://localhost:27017/atlas-ai

# JWT — CHANGE THESE SECRETS to long random strings in any real deployment.
JWT_SECRET=change-this-access-secret-to-a-long-random-string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-different-long-random-string
JWT_REFRESH_EXPIRE=7d

# Google Gemini — REQUIRED for AI features. Get a free key at https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# CORS — the frontend origin allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX=20

# Cookies — set true only when serving the API over HTTPS.
COOKIE_SECURE=false
