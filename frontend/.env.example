# ─────────────────────────────────────────────────────────────
# Wayfare — Frontend environment
# Copy this file to `.env` (Vite reads it automatically).
# Prefix every variable with VITE_ to expose it to browser code.
# ─────────────────────────────────────────────────────────────

# Backend API base URL — no trailing slash.
# Development: point at the local Express server.
VITE_API_URL=http://localhost:5000/api

# Production (Render): replace with your actual Render backend URL.
# VITE_API_URL=https://wayfare-backend.onrender.com/api

# Optional: override the app display name shown in the browser tab.
# VITE_APP_NAME=Wayfare
